PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/soletrack
MONGO_DB_NAME=soletrack
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
DNS_SERVERS=
# Optional, useful on local Windows networks where Node cannot resolve MongoDB Atlas SRV records.
# Example: DNS_SERVERS=8.8.8.8,1.1.1.1
